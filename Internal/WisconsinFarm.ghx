                <item name="Name" type_name="gh_string" type_code="10">Download Weather</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="6">
                    <item name="ChartMonthFrom" type_name="gh_int32" type_code="3">1</item>
                    <item name="ChartMonthTo" type_name="gh_int32" type_code="3">12</item>
                    <item name="Description" type_name="gh_string" type_code="10">Pick an EPW weather file from a bundled catalog of 60,867 climate files — every TMYx station on climate.onebuilding.org plus the EnergyPlus store (IWEC, TMY3, CWEC, SWERA, …) — with your own folders and Morph Weather results listed alongside them; its second list, Built for this site, holds the sources that build a file for your site (Open-Meteo, PVGIS, NASA POWER, Copernicus CDS). Click the Station widget and choose Weather file (catalog)… for a searchable table with a map, or type a name, WMO id or direct URL. The catalog is searched offline; only the chosen file is downloaded, once, into the weather cache.

Version 1.20.0.827

Version 1.20.0.827

Version 1.20.0.827

Version 1.20.0.827

Version 1.20.0.827

Version 1.20.0.827

Version 1.21.0.827</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">98352708-b0d9-4798-93cc-0f453c1d1cbe</item>
                    <item name="Name" type_name="gh_string" type_code="10">Download Weather</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Download Weather</item>
                  </items>
                  <chunks count="12">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
