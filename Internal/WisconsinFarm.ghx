                    <chunk name="param_input" index="23">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Resolve a box around the buildings at half the Grid Spacing (OpenLB): half their height upwind, one height on the sides, six heights downwind so the wakes stay inside (a box face across a wake loses it), up to twice their height; coupled to the rest of the lattice by OpenLB's Rohde scheme. Each refined cell costs 16 coarse ones (8 cells x 2 steps): it pays when the box is a small part of a large domain. Not with pollutants or heat fluxes yet.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">cad14a5f-a2ef-400e-a81a-8ff718343e92</item>
                        <item name="Name" type_name="gh_string" type_code="10">Refine</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Refine</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
