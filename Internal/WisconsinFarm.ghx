                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Options" type_name="gh_string" type_code="10">None (bounce-back)
Power law
Spalding
Rough (z0 from the ABL)</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                        <item name="Value" type_name="gh_string" type_code="10">None (bounce-back)</item>
                      </items>
