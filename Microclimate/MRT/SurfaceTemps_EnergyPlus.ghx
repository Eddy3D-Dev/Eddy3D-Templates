                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Options" type_name="gh_string" type_code="10">Two-Phase DDS
Two-Phase (preview)</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                        <item name="Value" type_name="gh_string" type_code="10">Two-Phase (preview)</item>
