                        <item name="Description" type_name="gh_string" type_code="10">What will run, one line each.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">0dd577eb-3f29-4bd7-82da-bffdb7171c61</item>
                        <item name="Name" type_name="gh_string" type_code="10">Summary</item>
