                        <chunk name="OutputParam" index="7">
                          <items count="7">
                            <item name="Access" type_name="gh_int32" type_code="3">1</item>
                            <item name="Description" type_name="gh_string" type_code="10">Aerodynamic roughness length z0 [m] per layer outline (by index, the last repeats), carried to the Layer Roughness output — one value per Layers mesh, for Ground Roughness. LiDAR Site's Layer Roughness output.</item>
                            <item name="InstanceGuid" type_name="gh_guid" type_code="9">29beadf9-2a92-402d-8c83-0e82cb59bdf9</item>
                            <item name="Name" type_name="gh_string" type_code="10">Layer Roughness</item>
