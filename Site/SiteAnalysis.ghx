                            <item name="NickName" type_name="gh_string" type_code="10">Period</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                            <item name="Options" type_name="gh_string" type_code="10">Year
Winter (Dec-Feb)
Spring (Mar-May)
Summer (Jun-Aug)
Autumn (Sep-Nov)
January
February
March
April
May
June
July
August
September
October
November
December</item>
