                    <chunk name="param_input" index="0">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">One scalar per point, in whatever unit the field is in — the Probe component's Values output for a single scalar field (CO2, T, age, Cp, p, k).</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">3996d384-c975-43c2-90fc-d5ccdba80739</item>
