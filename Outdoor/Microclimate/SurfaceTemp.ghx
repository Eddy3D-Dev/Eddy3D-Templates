                <item name="Lib" type_name="gh_guid" type_code="9">a3f7d2c4-9b18-4e56-8a2f-1d6c0b9e4f30</item>
                <item name="Name" type_name="gh_string" type_code="10">Sky Exposure</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Computes the Sky View Factor (SVF) for each input point using the Tregenza 145-patch sky subdivision. Casts 145 rays toward the upper hemisphere and returns the fraction of unobstructed sky directions (0 = fully obstructed, 1 = fully open sky).</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">b1fc0f2f-8db5-4232-9a37-b28e50dce2b3</item>
                    <item name="Name" type_name="gh_string" type_code="10">Sky Exposure</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Sky Exposure</item>
                  </items>
                  <chunks count="5">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                          <X>856</X>
                          <Y>231</Y>
                          <W>129</W>
                          <H>64</H>
                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>924</X>
                          <Y>263</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">List of 3D points at which sky exposure is computed. Rays are cast from the Offset height above each input point; use ground-surface points directly.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">e0858bc8-4031-4405-998c-88278d333553</item>
                        <item name="Name" type_name="gh_string" type_code="10">Positions</item>
