                        <item name="Options" type_name="gh_string" type_code="10">0 — 3 sky patches
1 — 12 sky patches
2 — 48 sky patches
3 — 192 sky patches
4 — 768 sky patches
5 — 3,072 sky patches
6 — 12,288 sky patches
7 — 49,152 sky patches
8 — 196,608 sky patches</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
