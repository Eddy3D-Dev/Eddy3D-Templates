                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">2</item>
                        <item name="Description" type_name="gh_string" type_code="10">The MRT component's Result (preferred), or a DataTree of annual MRT values — {probe}(8760) or {hour}(probes), both accepted.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">4654f9ad-5036-4da9-86a5-3ab638da450f</item>
                        <item name="Name" type_name="gh_string" type_code="10">MRT</item>
