                <item name="Name" type_name="gh_string" type_code="10">Download Weather</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="6">
                    <item name="ChartMonthFrom" type_name="gh_int32" type_code="3">1</item>
                    <item name="ChartMonthTo" type_name="gh_int32" type_code="3">12</item>
                    <item name="Description" type_name="gh_string" type_code="10">Pick an EPW weather file from a bundled catalog of 60,868 climate files — every TMYx station on climate.onebuilding.org plus the EnergyPlus store (IWEC, TMY3, CWEC, SWERA, …) — with your own folders and Morph Weather results listed alongside them. Click the Station widget and choose Weather file (catalog)… for a searchable table with a map, or type a name, WMO id or direct URL. The catalog is searched offline; only the chosen file is downloaded, once, into the weather cache.

Version 1.19.0.827</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">db74247e-4245-4fae-b9c7-79feb7b383e8</item>
                    <item name="Name" type_name="gh_string" type_code="10">Download Weather</item>
                    <item name="NickName" type_name="gh_string" type_code="10">Download Weather</item>
