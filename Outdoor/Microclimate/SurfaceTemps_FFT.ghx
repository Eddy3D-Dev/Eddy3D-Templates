                    <chunk name="param_output" index="6">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Longitude of the SITE in decimal degrees (east positive), from the same source as Site Latitude — never the weather station's. Wire it into Land Cover Roughness's Longitude.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">979d3b3a-1473-40b0-8bde-de7d2837e992</item>
                        <item name="Name" type_name="gh_string" type_code="10">Site Longitude</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Lon</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
