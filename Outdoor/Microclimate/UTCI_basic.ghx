                    <chunk name="param_input" index="1">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">Obstructing geometry for ray intersection (buildings, trees, walls). Accepts Mesh, Brep, or Surface. The ground surface need not be included.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">0e919d1d-9993-4a59-a0ee-e3cfa1b26022</item>
