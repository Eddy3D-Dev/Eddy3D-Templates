                    <chunk name="param_input" index="2">
                      <items count="9">
                        <item name="Description" type_name="gh_string" type_code="10">Resolution of the internal MRT sky hemisphere, as a SUBDIVISION LEVEL: the dome has 6 x 4^level faces, half of them above the horizon. Higher levels smooth the view factors but cost time on every probe; 5 (3072 patches) is ample for MRT.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">ce885833-8bee-40ca-8940-a06e5a95aee6</item>
                        <item name="Multiple" type_name="gh_bool" type_code="1">false</item>
                        <item name="Name" type_name="gh_string" type_code="10">Sky Dome Subdivisions</item>
                        <item name="NickName" type_name="gh_string" type_code="10">SkyDiv</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Options" type_name="gh_string" type_code="10">0 — 3 sky patches
1 — 12 sky patches
2 — 48 sky patches
3 — 192 sky patches
4 — 768 sky patches
5 — 3,072 sky patches
6 — 12,288 sky patches
7 — 49,152 sky patches
8 — 196,608 sky patches</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                        <item name="Value" type_name="gh_string" type_code="10"></item>
                      </items>
