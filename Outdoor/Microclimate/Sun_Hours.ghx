                    <chunk name="param_input" index="16">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Width [m] of a band inside the Domain outline in which the ground is eased to one elevation (the band's median), so the domain boundary is flat for the CFD inlet and outlets. 0 = off.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">0249f518-7dd7-4e49-b474-202b28754290</item>
