                    <chunk name="param_input" index="24">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">How many wind directions Run All solves AT ONCE (Docker / WSL). CPU Count is the budget they share: 4 directions on 16 CPUs run on 4 ranks each, which beats 16 ranks one after another once MPI scaling flattens (about 1M cells). Each direction logs to its own run_concurrent.txt; one failed direction fails the run. blueCFD stays sequential. 1 (the default) = one at a time.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">784da65f-f81e-4b81-a779-aa02bc9a67d7</item>
                        <item name="Name" type_name="gh_string" type_code="10">Concurrent Directions</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Concurrent</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="2">
