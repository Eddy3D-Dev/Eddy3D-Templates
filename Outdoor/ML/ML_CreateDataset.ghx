                <item name="Name" type_name="gh_string" type_code="10">Ground Roughness</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Assign a multi-face ground plate to the wind tunnel: each face gets its own aerodynamic roughness length z0 and becomes its own ground patch (nutkAtmRoughWallFunction). Feed into the wind case component's Ground Roughness input.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">521d29c4-dbdd-4265-8f1e-017fef3667a7</item>
                    <item name="Name" type_name="gh_string" type_code="10">Ground Roughness</item>
                    <item name="NickName" type_name="gh_string" type_code="10">GroundZ0</item>
                  </items>
                  <chunks count="6">
                    <chunk name="Attributes">
                      <items count="2">
                        <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
