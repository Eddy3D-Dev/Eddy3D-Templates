                        </item>
                        <item name="Pivot" type_name="gh_drawing_pointf" type_code="31">
                          <X>2973</X>
                          <Y>819</Y>
                        </item>
                      </items>
                    </chunk>
                    <chunk name="param_input" index="0">
                      <items count="8">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">Ground plate faces (meshes, breps, or surfaces), one per roughness zone. Faces must not overlap each other; together they replace the default inner ground surface.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">d14284cc-71fb-4069-b161-b53cd3400ea7</item>
                        <item name="Name" type_name="gh_string" type_code="10">Faces</item>
