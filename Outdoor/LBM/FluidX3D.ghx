                    <chunk name="param_input" index="6">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Lattice spacing in meters, or 0 for auto. Auto lets FluidX3D size the lattice to the Memory budget (the spacing is whatever the domain happens to get). A value fixes the discretization: ceil(L/dx) cells per axis, Memory becomes a check. Cell count grows with 1/dx^3 — halving dx costs 8x VRAM and ~16x time.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">c7fa022b-2f89-413a-a8a2-836572b0009c</item>
                        <item name="Name" type_name="gh_string" type_code="10">Grid Spacing</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Grid Spacing</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Source" index="0" type_name="gh_guid" type_code="9">197c4fc3-ec84-48d4-bda4-16d3d63574d9</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                      </items>
                      <chunks count="2">
