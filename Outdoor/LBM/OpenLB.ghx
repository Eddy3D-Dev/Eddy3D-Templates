                    <chunk name="param_input" index="0">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">Case directory (optional; default ~/Eddy3D/Cases/LBM). Must not contain spaces — it is mounted into the container.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">5eacd07d-bea0-4295-a6a7-6bb8823f65df</item>
