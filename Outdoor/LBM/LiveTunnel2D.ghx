                    <chunk name="param_output" index="11">
                      <items count="6">
                        <item name="Description" type_name="gh_string" type_code="10">The trees as individual round crowns on short trunks, ONE mesh over Terrain Size: from the cloud's own vegetation returns where it classifies any, else from the satellite canopy map (Meta/WRI CHM v2, 1 m, CC BY 4.0; most 3DEP projects classify none). 3 m and taller, none inside a footprint, at most the 20,000 tallest. For looking at and for a render, not a solver: Tree Crowns are the porous zones the Tree component takes. The Report says where they came from.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">5caf2b0d-87f9-447d-ac6e-f72af76af9d6</item>
                        <item name="Name" type_name="gh_string" type_code="10">Trees</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Trees</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">0</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
                            <item name="Bounds" type_name="gh_drawing_rectanglef" type_code="35">
                              <X>464</X>
                              <Y>630</Y>
                              <W>66</W>
                              <H>20</H>
                            </item>
