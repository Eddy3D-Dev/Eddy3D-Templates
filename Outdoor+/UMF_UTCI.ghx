                            <item name="Name" type_name="gh_string" type_code="10">Weather</item>
                            <item name="NickName" type_name="gh_string" type_code="10">Weather</item>
                            <item name="Optional" type_name="gh_bool" type_code="1">false</item>
                            <item name="Source" index="0" type_name="gh_guid" type_code="9">1947f6bf-8793-4f51-b57f-e3a65dc2aa6a</item>
