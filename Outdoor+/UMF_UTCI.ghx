                      </items>
                      <chunks count="9">
                        <chunk name="InputParam" index="0">
                          <items count="7">
                            <item name="Description" type_name="gh_string" type_code="10">Weather object, or an EPW file path (e.g. from Download Weather), to deconstruct.</item>
