                        <item name="Description" type_name="gh_string" type_code="10">Sensor probes (MRT Sensors). Branches are flattened.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">ebc81c74-a4ae-42eb-8bb5-bebee8dbc397</item>
                        <item name="Name" type_name="gh_string" type_code="10">Sensors</item>
