                    <chunk name="param_output" index="2">
                      <items count="7">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">The catalog entries that matched, nearest the site first. One line per file: name, dataset, source and distance.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">d53d6c68-bdea-4a3d-aaea-cd88630a2259</item>
                        <item name="Name" type_name="gh_string" type_code="10">Stations</item>
