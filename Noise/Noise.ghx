            <chunk name="Object" index="11">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">8c41d2b7-5e96-4a83-b1f0-64c2a9d7e315</item>
                <item name="Lib" type_name="gh_guid" type_code="9">82b21a65-da8f-433c-93fb-f9814609e1d6</item>
                <item name="Name" type_name="gh_string" type_code="10">Flex Legend</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="5">
                    <item name="Description" type_name="gh_string" type_code="10">Create a metric-aware color legend and an optional colored mesh from point/value samples. Supports wind, solar, sun-hours, temperature and other environmental data.

