                      <items count="7">
                        <item name="Access" type_name="gh_int32" type_code="3">1</item>
                        <item name="Description" type_name="gh_string" type_code="10">Optional geometry drawn as solid lines over the map, so the bands and lines stay readable against the buildings that cast them. Curves (footprints) are draped onto the field and lifted by Offset; Breps and Meshes (City Surface's Buildings, LiDAR Site's masses) draw as their edge wireframes where they are, so the buildings read in 3D above their footprints.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">4481833f-06cd-494e-b301-0bba446c5f42</item>
                        <item name="Name" type_name="gh_string" type_code="10">Outlines</item>
                        <item name="NickName" type_name="gh_string" type_code="10">Outlines</item>
