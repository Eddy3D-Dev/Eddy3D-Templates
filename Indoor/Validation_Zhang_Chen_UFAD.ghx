                    <chunk name="param_input" index="1">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Optional room surface to give this temperature. Must be part of the room Brep's shell; leave empty to set one case-wide wall temperature instead.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">8daf9d53-0544-4eee-b529-7a3ec9a3eccf</item>
                        <item name="Name" type_name="gh_string" type_code="10">Surface</item>
