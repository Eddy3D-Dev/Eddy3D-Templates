                            </item>
                          </items>
                        </chunk>
                      </chunks>
                    </chunk>
                    <chunk name="param_input" index="2">
                      <items count="7">
                        <item name="Description" type_name="gh_string" type_code="10">Optional patch name (letters/digits/underscore). Defaults to a positional name.</item>
                        <item name="InstanceGuid" type_name="gh_guid" type_code="9">3f4bcda1-22a5-40c4-9f16-0a0a4fea7e30</item>
                        <item name="Name" type_name="gh_string" type_code="10">Name</item>
                        <item name="NickName" type_name="gh_string" type_code="10">N</item>
                        <item name="Optional" type_name="gh_bool" type_code="1">true</item>
                        <item name="Source" index="0" type_name="gh_guid" type_code="9">0bd0e1a5-5bdf-4804-8f05-32e3940cb582</item>
                        <item name="SourceCount" type_name="gh_int32" type_code="3">1</item>
                      </items>
                      <chunks count="1">
                        <chunk name="Attributes">
                          <items count="2">
