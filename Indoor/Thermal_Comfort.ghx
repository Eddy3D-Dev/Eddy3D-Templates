              <chunks count="1">
                <chunk name="Container">
                  <items count="4">
                    <item name="Description" type_name="gh_string" type_code="10">Set an indoor wall temperature (°C). Wire a room surface to give just that surface its own temperature patch; leave it empty for a single case-wide wall temperature.</item>
                    <item name="InstanceGuid" type_name="gh_guid" type_code="9">271055d5-88b9-4639-904f-1a51a73a1654</item>
                    <item name="Name" type_name="gh_string" type_code="10">Indoor Wall</item>
